{
  "name": "rincon-de-salo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "limpiar-basura-macos": "find .output/public -name '._*' -delete 2>/dev/null || true",
    "generate-con-reintento": "nuxt generate || nuxt generate",
    "deploy": "npm run generate-con-reintento && npm run limpiar-basura-macos && wrangler pages deploy .output/public"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/robots": "^6.1.3",
    "@nuxtjs/sitemap": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
