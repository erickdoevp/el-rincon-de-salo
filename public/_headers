# Cabeceras para Cloudflare Pages.
# Este archivo se copia tal cual a la raíz del sitio publicado.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Recursos con hash en el nombre: si cambian, cambia la URL.
# Se pueden cachear para siempre sin riesgo de servir algo viejo.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

/_fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Las imágenes optimizadas no llevan hash: la URL solo describe el recorte.
# Si Salo reemplaza una foto conservando el nombre, la URL no cambia, así que
# un mes es el equilibrio entre caché y poder actualizar fotos.
/_ipx/*
  Cache-Control: public, max-age=2592000
